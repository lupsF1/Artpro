# 复制为项目根目录 .env（apps/api 启动时会读取，见 apps/api/app/config.py）
#
# --- 默认：不写 DATABASE_* 时使用 SQLite（apps/api/data/artpro.db），无需 Docker ---
#
# --- 可选：PostgreSQL（与 docker-compose.yml 中 db 服务一致）---
# 1) 仓库根执行: docker compose up -d
# 2) 取消下面两行注释（或复制到 .env）后，在 apps/api 下执行 alembic upgrade head
# DATABASE_URL=postgresql+asyncpg://artpro:artpro@127.0.0.1:5432/artpro
# DATABASE_URL_SYNC=postgresql+psycopg://artpro:artpro@127.0.0.1:5432/artpro
#
# DEBUG=0
# 生产建议关闭 Swagger/OpenAPI 页面（减少暴露面）
# API_DOCS_ENABLED=false
# 公开留资接口按 IP 限流（slowapi，如 30/minute）；网关层可再叠加 WAF
# LEADS_RATE_LIMIT=30/minute
# 逗号分隔多个 origin（生产须为 https 真实域名）
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 管理端 JWT 与账号（留空则登录接口返回未配置）
# ADMIN_JWT_SECRET=请替换为至少32字节的随机串
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=  # bcrypt，如: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('secret'))"
# ADMIN_TOKEN_EXPIRES_MINUTES=480

# 前端 apps/web（复制为 apps/web/.env.local）
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
