# 复制为项目根目录 .env（apps/api 启动时会读取，见 apps/api/app/config.py）
#
# --- 默认：不写 DATABASE_* 时使用 SQLite（apps/api/data/artpro.db），无需 Docker ---
#
# --- 可选：PostgreSQL（与 docker-compose.yml 中 db 服务一致）---
# 1) 仓库根执行: docker compose up -d
# 2) 取消下面两行注释（或复制到 .env）后，在 apps/api 下执行 alembic upgrade head
# DATABASE_URL=postgresql+asyncpg://artpro:artpro@127.0.0.1:5432/artpro
# DATABASE_URL_SYNC=postgresql+psycopg://artpro:artpro@127.0.0.1:5432/artpro
#
# DEBUG=0
# 生产建议关闭 Swagger/OpenAPI 页面（减少暴露面）
# API_DOCS_ENABLED=false
# 公开留资接口按 IP 限流（slowapi，如 30/minute）；网关层可再叠加 WAF
# LEADS_RATE_LIMIT=30/minute
# 艺考咨询助手 SSE（POST /api/v1/assistant/chat）
# ASSISTANT_RATE_LIMIT=20/minute
# 知识库单文件上传上限（MB）
# KB_MAX_UPLOAD_MB=10
# Embeddings（OpenAI 兼容 POST /v1/embeddings）；可单独网关/Key
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=
# KB_CHUNK_SIZE=900
# KB_CHUNK_OVERLAP=120
# RAG_TOP_K=5
# RAG_MIN_COSINE=0.22
# 混合检索召回池：稠密向量 Top-N + BM25 Top-N，合并后再元数据过滤和重排序
# RAG_DENSE_TOP_K=30
# RAG_BM25_TOP_K=30
# 可选 Cross-Encoder/Reranker 服务；未配置时使用本地轻量重排序
# RERANKER_BASE_URL=
# RERANKER_MODEL=
# RERANKER_API_KEY=
# 逗号分隔多个 origin（生产须为 https 真实域名）
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 管理端 JWT 与账号（留空则登录接口返回未配置）
# ADMIN_JWT_SECRET=请替换为至少32字节的随机串
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=  # bcrypt，如: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('secret'))"
# ADMIN_TOKEN_EXPIRES_MINUTES=480

# --- 文章 AI 流水线（OpenAI 兼容 Chat；默认小米 MiMo）---
# 官方文档：https://platform.xiaomimimo.com/docs/zh-CN/api/chat/openai-api
# 控制台密钥：https://platform.xiaomimimo.com/#/console/api-keys
# MIMO_API_KEY=你的小米_MiMo_API_Key
# 与 OpenAI 二选一：OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.xiaomimimo.com/v1
# OPENAI_MODEL=xiaomi/mimo-v2-flash
#
# 文章 AI 修订历史（article_revisions）：默认保留 24 小时内记录，进程内每 24 小时清理一次（可关）
# ARTICLE_REVISION_CLEANUP_ENABLED=true
# ARTICLE_REVISION_RETENTION_HOURS=24
# ARTICLE_REVISION_CLEANUP_INTERVAL_SECONDS=86400

# 前端 apps/web（复制为 apps/web/.env.local）
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
