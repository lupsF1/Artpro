# 复制为项目根目录 .env 或 apps/api/.env（Pydantic 会从 .env 加载）
# API（apps/api 运行时读取）
# DATABASE_URL=postgresql+asyncpg://artpro:artpro@127.0.0.1:5432/artpro
# DATABASE_URL_SYNC=postgresql+psycopg://artpro:artpro@127.0.0.1:5432/artpro
# DEBUG=0
# 逗号分隔多个 origin
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 管理端 JWT 与账号（留空则登录接口返回未配置）
# ADMIN_JWT_SECRET=请替换为至少32字节的随机串
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=  # bcrypt，如: python -c "import bcrypt; print(bcrypt.hashpw(b'密码', bcrypt.gensalt()).decode())"
# ADMIN_TOKEN_EXPIRES_MINUTES=480

# 前端 apps/web（复制为 apps/web/.env.local）
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
